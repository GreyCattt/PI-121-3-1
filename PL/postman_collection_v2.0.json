{
  "info": {
    "_postman_id": "8d7b2f9a-collection-0001-v2",
    "name": "AuctionSystem API (v2.0)",
    "schema": "https://schema.getpostman.com/json/collection/v2.0.0/collection.json",
    "description": "Collection to exercise AuctionSystem API via Postman. The API runs on http://localhost:5184 in development; token is saved automatically after login."
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{ \"email\": \"admin@auction.com\", \"password\": \"Admin123!\" }" },
        "url": { "raw": "http://localhost:5184/api/Auth/login", "host": ["localhost"], "port": "5184", "path": ["api","Auth","login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Якщо відповідь успішна — зберігаємо токен в environment (чутливість до Token/token)",
              "if (pm.response && pm.response.code === 200) {",
              "  try {",
              "    var body = pm.response.json();",
              "    var t = (body && (body.token || body.Token)) || '';",
              "    if (typeof t === 'string') {",
              "      t = t.replace(/^\"|\"$/g, '');",
              "    }",
              "    if (t) { pm.environment.set('token', t); }",
              "  } catch (e) { }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"username\": \"{{registerUsername}}\", \"email\": \"{{registerEmail}}\", \"password\": \"Buyer123!\" }" },
        "url": { "raw": "http://localhost:5184/api/Auth/register", "host": ["localhost"], "port": "5184", "path": ["api","Auth","register"] }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var stamp = Date.now().toString();",
              "pm.variables.set('registerUsername', 'buyer_' + stamp);",
              "pm.variables.set('registerEmail', 'buyer_' + stamp + '@example.com');"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5184/api/Auth/me", "host": ["localhost"], "port": "5184", "path": ["api","Auth","me"] }
      }
    },
    {
      "name": "Lots - Get All",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:5184/api/Lots", "host": ["localhost"], "port": "5184", "path": ["api","Lots"] }
      }
    },
    {
      "name": "Lots - Search",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:5184/api/Lots/search?searchQuery=phone&minPrice=10&maxPrice=500", "host": ["localhost"], "port": "5184", "path": ["api","Lots","search"], "query": [] }
      }
    },
    {
      "name": "Lots - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"title\": \"Test lot\", \"description\": \"Test via Postman\", \"startingPrice\": 10.5, \"startTime\": \"2026-06-03T00:00:00\", \"endTime\": \"2026-06-10T00:00:00\", \"categoryId\": 1 }" },
        "url": { "raw": "http://localhost:5184/api/Lots", "host": ["localhost"], "port": "5184", "path": ["api","Lots"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Якщо створення повертає id в тілі (наприклад: 3005), збережемо його для подальших запитів",
              "if (pm.response && pm.response.code === 201) {",
              "  try {",
              "    var bodyText = pm.response.text();",
              "    var id = null;",
              "    try { id = JSON.parse(bodyText); } catch(e) { /* not JSON */ }",
              "    if (!id && pm.response.json && typeof pm.response.json === 'function') {",
              "      var parsed = pm.response.json();",
              "      if (parsed && parsed.id) id = parsed.id;",
              "    }",
              "    // if id is still falsy, try using raw body text digits",
              "    if (!id) {",
              "      var m = bodyText.match(/\\d+/);",
              "      if (m) id = m[0];",
              "    }",
              "    if (id) pm.environment.set('lastCreatedLotId', id.toString());",
              "  } catch (e) { }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Lots - Get By Id",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:5184/api/Lots/{{lastCreatedLotId}}", "host": ["localhost"], "port": "5184", "path": ["api","Lots","{{lastCreatedLotId}}"] }
      }
    },
    {
      "name": "Lots - Update",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"title\": \"Updated lot\", \"description\": \"Updated via Postman\", \"startingPrice\": 20.0, \"startTime\": \"2026-06-04T00:00:00\", \"endTime\": \"2026-06-11T00:00:00\", \"categoryId\": 1, \"status\": \"Pending\" }" },
        "url": { "raw": "http://localhost:5184/api/Lots/{{lastCreatedLotId}}", "host": ["localhost"], "port": "5184", "path": ["api","Lots","{{lastCreatedLotId}}"] }
      }
    },
    {
      "name": "Lots - Approve",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5184/api/Lots/{{lastCreatedLotId}}/approve?managerId=2", "host": ["localhost"], "port": "5184", "path": ["api","Lots","{{lastCreatedLotId}}","approve"], "query": [{ "key": "managerId", "value": "2" }] }
      }
    },
    {
      "name": "Auction - Place Bid",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"lotId\": {{lastCreatedLotId}}, \"amount\": 25.0 }" },
        "url": { "raw": "http://localhost:5184/api/Auction/bids", "host": ["localhost"], "port": "5184", "path": ["api","Auction","bids"] }
      }
    },
    {
      "name": "Lots - Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5184/api/Lots/{{lastCreatedLotId}}", "host": ["localhost"], "port": "5184", "path": ["api","Lots","{{lastCreatedLotId}}"] }
      }
    },
    {
      "name": "Categories - Get All",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:5184/api/Categories", "host": ["localhost"], "port": "5184", "path": ["api","Categories"] }
      }
    },
    {
      "name": "Categories - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"name\": \"NewCategory\" }" },
        "url": { "raw": "http://localhost:5184/api/Categories", "host": ["localhost"], "port": "5184", "path": ["api","Categories"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response && (pm.response.code === 200 || pm.response.code === 201)) {",
              "  try {",
              "    var bodyText = pm.response.text();",
              "    var id = null;",
              "    try { id = JSON.parse(bodyText); } catch (e) { }",
              "    if (!id && pm.response.json && typeof pm.response.json === 'function') {",
              "      var parsed = pm.response.json();",
              "      if (parsed && parsed.id) id = parsed.id;",
              "    }",
              "    if (!id) {",
              "      var m = bodyText.match(/\\d+/);",
              "      if (m) id = m[0];",
              "    }",
              "    if (id) pm.environment.set('lastCreatedCategoryId', id.toString());",
              "  } catch (e) { }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Categories - Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5184/api/Categories/{{lastCreatedCategoryId}}", "host": ["localhost"], "port": "5184", "path": ["api","Categories","{{lastCreatedCategoryId}}"] }
      }
    }
  ]
}
