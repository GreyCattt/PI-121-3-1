{
  "info": {
    "_postman_id": "8d7b2f9a-collection-0001",
    "name": "AuctionSystem API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection to exercise AuctionSystem API via Postman. Set variable `baseUrl` to your API base (e.g., https://localhost:7071) and `token` after login."
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{ \"email\": \"admin@auction.com\", \"password\": \"Admin123!\" }" },
        "url": { "raw": "{{baseUrl}}/api/Auth/login", "host": ["{{baseUrl}}"], "path": ["api","Auth","login"] }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{ \"username\": \"buyer1\", \"email\": \"buyer1@example.com\", \"password\": \"Buyer123!\" }" },
        "url": { "raw": "{{baseUrl}}/api/Auth/register", "host": ["{{baseUrl}}"], "path": ["api","Auth","register"] }
      }
    },
    {
      "name": "Auth - Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/Auth/me", "host": ["{{baseUrl}}"], "path": ["api","Auth","me"] }
      }
    },
    {
      "name": "Lots - Get All",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/Lots", "host": ["{{baseUrl}}"], "path": ["api","Lots"] }
      }
    },
    {
      "name": "Lots - Search",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/Lots/search?searchQuery=phone&minPrice=10&maxPrice=500", "host": ["{{baseUrl}}"], "path": ["api","Lots","search"], "query": [] }
      }
    },
    {
      "name": "Lots - Get By Id",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/Lots/1", "host": ["{{baseUrl}}"], "path": ["api","Lots","1"] }
      }
    },
    {
      "name": "Lots - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"title\": \"Test lot\", \"description\": \"Test via Postman\", \"startingPrice\": 10.5, \"startTime\": \"2026-06-03T00:00:00\", \"endTime\": \"2026-06-10T00:00:00\", \"categoryId\": 1 }" },
        "url": { "raw": "{{baseUrl}}/api/Lots", "host": ["{{baseUrl}}"], "path": ["api","Lots"] }
      }
    },
    {
      "name": "Lots - Update",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"title\": \"Updated lot\", \"description\": \"Updated via Postman\", \"startingPrice\": 20.0, \"startTime\": \"2026-06-04T00:00:00\", \"endTime\": \"2026-06-11T00:00:00\", \"categoryId\": 1, \"status\": \"Active\" }" },
        "url": { "raw": "{{baseUrl}}/api/Lots/1", "host": ["{{baseUrl}}"], "path": ["api","Lots","1"] }
      }
    },
    {
      "name": "Lots - Approve",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/Lots/1/approve?managerId=2", "host": ["{{baseUrl}}"], "path": ["api","Lots","1","approve"], "query": [{ "key": "managerId", "value": "2" }] }
      }
    },
    {
      "name": "Lots - Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/Lots/1", "host": ["{{baseUrl}}"], "path": ["api","Lots","1"] }
      }
    },
    {
      "name": "Categories - Get All",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/Categories", "host": ["{{baseUrl}}"], "path": ["api","Categories"] }
      }
    },
    {
      "name": "Categories - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"name\": \"NewCategory\" }" },
        "url": { "raw": "{{baseUrl}}/api/Categories", "host": ["{{baseUrl}}"], "path": ["api","Categories"] }
      }
    },
    {
      "name": "Categories - Delete",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/Categories/1", "host": ["{{baseUrl}}"], "path": ["api","Categories","1"] }
      }
    },
    {
      "name": "Auction - Place Bid",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
        "body": { "mode": "raw", "raw": "{ \"lotId\": 1, \"amount\": 15.0 }" },
        "url": { "raw": "{{baseUrl}}/api/Auction/bids", "host": ["{{baseUrl}}"], "path": ["api","Auction","bids"] }
      }
    }
  ]
}
